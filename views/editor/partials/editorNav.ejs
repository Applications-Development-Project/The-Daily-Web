<%#
  views/editor/partials/editorNav.ejs

  The navigation bar of every editor page. A page includes it with
  include('partials/editorNav', { activePage: 'analytics' }); activePage ('dashboard',
  'analytics', 'users' or 'comments') marks the current link. The links protect nothing:
  every /editor route checks the role on the server.

  Included by: the editor pages (dashboard, articleReview, analytics, users, comments).
  Owner: SM.
%>
<%
  // One list, so a link's HTML is written once below.
  const editorLinks = [
    { page: 'dashboard', href: '/editor', label: 'Articles' },
    { page: 'analytics', href: '/editor/analytics', label: 'Impact Analytics' },
    { page: 'users', href: '/editor/users', label: 'Users' },
    { page: 'comments', href: '/editor/comments', label: 'Comments' },
  ];

  // locals.activePage: reading a local that wasn't passed would crash the page.
  const activePage = locals.activePage;
%>
<nav class="editor-nav" aria-label="Editor area">
  <ul class="editor-nav-list">
    <% editorLinks.forEach(function (link) { %>
      <li>
        <%# aria-current tells screen readers (and the CSS) which page this is. %>
        <a class="editor-nav-link" href="<%= link.href %>"<% if (link.page === activePage) { %> aria-current="page"<% } %>><%= link.label %></a>
      </li>
    <% }); %>
  </ul>
</nav>
