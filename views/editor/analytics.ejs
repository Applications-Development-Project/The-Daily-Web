<%#
  views/editor/analytics.ejs

  The Impact Analytics page: search an article, choose a period, see its views on a
  chart with a numbered line at every publish, and reset its statistics. This file is
  the frame; public/js/editor/analytics.js does the work without reloading the page.

  Chart.js 4.5.1 comes from cdnjs, on this page only (no npm package). The integrity
  hash makes the browser refuse the file if the CDN ever sends a different one.

  Rendered by: showAnalyticsPage (controllers/analyticsController.js), for GET /editor/analytics.
  Locals: title, rangeOptions, defaultRangeDays, initialArticle ({ id, title } or null), notice.
  Owner: SM.
%>
<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: title }) %>

<body class="page-container">
  <%- include('../partials/header') %>
  <%- include('partials/editorNav', { activePage: 'analytics' }) %>

  <%# The data-* attributes pass the server's values to the script (escaped, like all output). %>
  <main class="main-content" id="analytics-page"
    data-default-range-days="<%= defaultRangeDays %>"
    data-initial-article-id="<%= initialArticle ? initialArticle.id : '' %>"
    data-initial-article-title="<%= initialArticle ? initialArticle.title : '' %>">
    <h2>Impact Analytics</h2>
    <p>Pick an article to see how many times it was viewed, hour by hour, and how the views
      changed after each update was published.</p>

    <% if (notice) { %>
      <p class="form-error"><%= notice %></p>
    <% } %>

    <form id="article-picker" class="card" role="search">
      <label for="article-search">Find an article by title</label>
      <input type="search" id="article-search" name="search" class="form-field"
        maxlength="200" placeholder="Part of a title..." autocomplete="off">
      <p id="article-results-message" aria-live="polite" hidden></p>
      <ul id="article-results"></ul>
    </form>

    <%# Hidden until an article is chosen. %>
    <section id="analytics-panel" class="card" aria-labelledby="chart-article-title" hidden>
      <h3 id="chart-article-title"></h3>

      <label for="range-select">Period</label>
      <select id="range-select" class="form-field">
        <% rangeOptions.forEach(function (option) { %>
          <option value="<%= option.days %>"<% if (option.days === defaultRangeDays) { %> selected<% } %>><%= option.label %></option>
        <% }); %>
      </select>

      <p id="chart-summary" aria-live="polite"></p>
      <p id="chart-message" aria-live="polite" hidden></p>

      <%# A canvas is only pixels: role="img" and the aria-label (updated by the script) are what screen readers read. %>
      <canvas id="views-chart" role="img" aria-label="Chart of views over time">
        Your browser can't show the chart. The summary above gives the numbers.
      </canvas>

      <h4>Published in this period (the numbered dashed lines)</h4>
      <ol id="publish-list"></ol>
      <p id="publish-empty" class="empty-state" hidden>Not published in this period.</p>

      <h4>Reset statistics</h4>
      <p>Deletes every view counted for this article and sets its total to 0. The publish
        history stays. This can't be undone.</p>
      <button type="button" id="reset-views" class="btn btn-danger">Reset statistics</button>
      <p id="reset-message" aria-live="polite" hidden></p>
    </section>

    <noscript>
      <p class="form-error">Impact Analytics needs JavaScript. Please turn it on.</p>
    </noscript>
  </main>

  <%- include('../partials/footer') %>

  <script src="/js/shared/apiClient.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.1/chart.umd.min.js"
    integrity="sha512-WoViKhKD4qI2WruSZqv9+kvM4WfFhUMQCLN4QlDTt5aU56fLQy2gYoxWIqlEnXqJy/+Ac5q/hk1oWfqnMDhwMA=="
    crossorigin="anonymous" referrerpolicy="no-referrer"></script>
  <script src="/js/editor/analytics.js"></script>
</body>
</html>
