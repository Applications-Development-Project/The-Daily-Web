<!DOCTYPE html>
<html lang="en">
<!-- Load the head partial and pass a dynamic title -->
<%- include('../partials/head', { title: 'Tech Giants Release New AI Framework - The Web Daily' }) %>

<body class="page-container">
    <%- include('../partials/header') %>

    <div class="main-content-wrapper">
        <main class="main-content">
            
            <article class="card">
                <span class="status-badge status-published">Technology</span>
                <h1 style="margin: var(--spacing-md) 0;">Tech Giants Release New AI Framework</h1>
                <p style="color: #666; margin-bottom: var(--spacing-lg);">
                    By John Doe | Published: <time>10 Oct 2026, 11:00</time>
                </p>
                
                <img src="https://via.placeholder.com/800x400" alt="AI abstract representation" style="width: 100%; border-radius: 8px; margin-bottom: var(--spacing-lg);">
                
                <div class="article-body">
                    <p>This is the full text of the article. In the final version, this content will be injected by the server using EJS so search engines can read it immediately.</p>
                    <p>It can span multiple paragraphs and contains the core value of the page.</p>
                </div>
            </article>

            <!-- Comments Section -->
            <section id="comments" data-article-id="1" class="card">
                <h3>Comments</h3>
                
                <ul id="comment-list">
                    <li class="comment">
                        <p class="comment-meta">
                            <span class="comment-author">Jane Reader</span>
                            <time class="comment-date" datetime="2026-10-10T13:51:00.000Z">10 Oct 2026, 13:51</time>
                        </p>
                        <p class="comment-text">This framework looks amazing! Can't wait to test it out.</p>
                    </li>
                </ul>

                <div id="comment-error" class="form-error"></div>

                <form id="comment-form">
                    <input type="text" name="authorName" class="form-field" placeholder="Your Name" required maxlength="50">
                    <textarea name="text" class="form-field" placeholder="Write a comment..." rows="4" required maxlength="1000"></textarea>
                    <button type="submit" class="btn btn-primary">Post Comment</button>
                </form>
            </section>

        </main>

        <%- include('../partials/sidebar') %>
    </div>

    <%- include('../partials/footer') %>

    <!-- Required scripts for comments functionality -->
    <script src="/js/shared/apiClient.js"></script>
    <script src="/js/articleComments.js"></script>
</body>
</html>