<!DOCTYPE html>
<html lang="en">
<!-- 
  views/public/article.ejs
  Single article page with full text and comments.
  Owner: SH.
-->
<!-- Load the head partial and pass the dynamic title from the controller -->
<%- include('../partials/head', { title: title }) %>

<body class="page-container">
    <%- include('../partials/header') %>

    <div class="main-content-wrapper">
        <main class="main-content">
            
            <article class="card">
                <span class="status-badge status-published"><%= article.published.category || 'News' %></span>
                <h1 style="margin: var(--spacing-md) 0;"><%= article.published.title %></h1>
                
                <p style="color: #666; margin-bottom: var(--spacing-lg);">
                    By <%= article.reporter && article.reporter.displayName ? article.reporter.displayName : 'Unknown' %> | Published: 
                    <time datetime="<%= article.lastPublishedAt.toISOString() %>">
                        <%= new Date(article.lastPublishedAt).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                    </time>
                </p>
                
                <!-- Display an image only if the article has one -->
                <% if (article.published.imageUrl) { %>
                    <img src="<%= article.published.imageUrl %>" alt="<%= article.published.title %>" style="width: 100%; border-radius: 8px; margin-bottom: var(--spacing-lg);">
                <% } %>
                
                <div class="article-body">
                    <!-- Defense Question - Security: Why use <%= %> here? -->
                    <!-- Using <%= %> escapes HTML and prevents Stored XSS injection attacks. Even though content is approved by an editor, we enforce strict server-side escaping for public viewers. -->
                    <%= article.published.body %>
                </div>
            </article>

            <!-- Comments Section -->
            <!-- Defense Question - Contracts: What is the comment markup contract with OS? -->
            <!-- OS's client-side script (public/js/public/articleComments.js) relies strictly on the IDs (#comments, #comment-list, #comment-form, #comment-error) and the data-article-id attribute below to know exactly which article to attach new comments to. -->
            <section id="comments" data-article-id="<%= article._id %>" class="card">
                <h3>Comments</h3>
                
                <ul id="comment-list">
                    <% if (comments && comments.length > 0) { %>
                        <% comments.forEach(function(comment) { %>
                            <li class="comment">
                                <p class="comment-meta">
                                    <span class="comment-author"><%= comment.authorName %></span>
                                    <time class="comment-date" datetime="<%= comment.createdAt.toISOString() %>">
                                        <%= comment.createdAt.toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                    </time>
                                </p>
                                <p class="comment-text"><%= comment.text %></p>
                            </li>
                        <% }); %>
                    <% } else { %>
                        <li class="empty-state">No comments yet.</li>
                    <% } %>
                </ul>

                <div id="comment-error" class="form-error" role="alert" hidden></div>

                <form id="comment-form">
                    <input type="text" name="authorName" class="form-field" placeholder="Your Name" required maxlength="50">
                    <textarea name="text" class="form-field" placeholder="Write a comment..." rows="4" required maxlength="1000"></textarea>
                    <button type="submit" class="btn btn-primary">Post Comment</button>
                </form>
            </section>

        </main>

        <%- include('../partials/sidebar') %>
    </div>

    <%- include('../partials/footer') %>

    <!-- Required scripts for comments functionality -->
    <script src="/js/shared/apiClient.js"></script>
    <script src="/js/public/articleComments.js"></script>
    <script src="/js/public/weatherWidget.js"></script>
</body>
</html>