<!DOCTYPE html>
<html lang="en">
<!-- 
  views/public/feed.ejs
  Main feed view with initial server-side rendering (SSR).
  Owner: SH.
-->
<%- include('../partials/head', { title: 'The Web Daily - Latest News' }) %>

<!-- 
  Defense Question - Architecture: Why use semantic HTML5 (main, aside, article, time) and Flexbox?
  Semantic HTML improves accessibility for screen readers and helps search engines understand the page structure. 
  Flexbox (used in page-container and main-content-wrapper) allows the sidebar to effortlessly stack below the main content on mobile devices without relying on complex floats.
-->
<body class="page-container">
    <%- include('../partials/header') %>

    <div class="main-content-wrapper">
        <main class="main-content">
            
            <!-- Filters & Search Section -->
            <div class="filters-container card" style="margin-bottom: var(--spacing-lg);">
                <!-- Defense Question - Accessibility: Why are there aria-labels here? -->
                <!-- aria-labels ensure visually impaired users using screen readers know exactly what each input does, even without a visible <label> tag. -->
                <input type="text" id="search-input" class="form-field" placeholder="Search articles..." aria-label="Search articles">
                <div style="display: flex; gap: var(--spacing-sm); margin-top: var(--spacing-sm); flex-wrap: wrap;">
                    <select id="category-filter" class="form-field" aria-label="Filter by category">
                        <option value="">All Categories</option>
                        <option value="News">News</option>
                        <option value="Economy">Economy</option>
                        <option value="Technology">Technology</option>
                        <option value="Sports">Sports</option>
                        <option value="Entertainment">Entertainment</option>
                        <option value="Health">Health</option>
                        <option value="Politics">Politics</option>
                        <option value="Culture">Culture</option>
                    </select>
                    
                    <select id="viewed-filter" class="form-field" aria-label="Filter by viewed status">
                        <option value="">All Articles</option>
                        <option value="unviewed">Unviewed Only</option>
                        <option value="viewed">Viewed Only</option>
                    </select>
                    
                    <select id="sort-select" class="form-field" aria-label="Sort articles">
                        <option value="newest">Newest First</option>
                        <option value="popular">Most Popular</option>
                    </select>
                    
                    <!-- Reset views button for Item 8 -->
                    <button id="reset-views-btn" class="btn btn-secondary">Reset History</button>
                </div>
            </div>

            <!-- Feed List -->
            <div id="feed-list">
                <!-- Server-side rendered initial 20 articles (Item 9) -->
                <% if (typeof articles !== 'undefined' && articles.length > 0) { %>
                    <% articles.forEach(function(article) { %>
                        <article class="card" style="margin-bottom: var(--spacing-md);">
                            <span class="status-badge status-published"><%= article.category || 'News' %></span>
                            <h3 style="margin: var(--spacing-sm) 0;">
                                <a href="/articles/<%= article.id %>" style="text-decoration: none; color: inherit;"><%= article.title %></a>
                            </h3>
                            <p style="font-size: 0.9rem; color: #666; margin-bottom: var(--spacing-sm);">
                                By <%= article.reporterName %> | 
                                <time datetime="<%= article.publishedAt.toISOString() %>">
                                    <%= new Date(article.publishedAt).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                </time> | <%= article.totalViews || 0 %> views
                            </p>
                            <% if (article.imageUrl) { %>
                                <!-- Defense Question - Edge cases: Why is onerror used here? -->
                                <!-- If the image URL is broken or the external host is down, the onerror event replaces the broken image icon with a local fallback placeholder image. -->
                                <img src="<%= article.imageUrl %>" alt="<%= article.title %>" onerror="this.onerror=null; this.src='/images/placeholder.jpg';" style="width: 100%; border-radius: 8px; margin-bottom: var(--spacing-sm);">
                            <% } %>
                            
                            <!-- Defense Question - Security: Why use <%= %> instead of <%- %> for the summary? -->
                            <!-- <%= %> automatically HTML-escapes the text. If a malicious reporter saved a <script> tag in the summary, it will be rendered as harmless text rather than executed (XSS prevention). -->
                            <p><%= article.summary %></p>
                        </article>
                    <% }); %>
                <% } %>
            </div>

        </main>

        <%- include('../partials/sidebar') %>
    </div>

    <%- include('../partials/footer') %>

    <!-- Required scripts -->
    <script src="/js/shared/apiClient.js"></script>
    <script src="/js/feed.js"></script>
</body>
</html>