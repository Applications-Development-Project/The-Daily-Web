<%#
  views/public/error.ejs

  The one error page for every error on a normal page (APIs get JSON instead): 404,
  401/403, 400 and 500. Usually rendered by middleware/errorHandler.js after next(error).
  Locals: statusCode, message (both printed escaped).

  Owner: OS.
%>
<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: statusCode + ' - The Daily Web' }) %>

<body class="page-container">
  <%#
    An error can happen before (or inside) setCurrentUser, and then currentUser doesn't
    exist. "locals.currentUser || null" keeps the error page itself from failing.
  %>
  <%- include('../partials/header', { currentUser: locals.currentUser || null }) %>

  <main class="main-content">
    <section class="empty-state" aria-labelledby="error-title">
      <h2 id="error-title">Error <%= statusCode %></h2>
      <p><%= message %></p>
      <p><a class="btn btn-primary" href="/">Back to the home page</a></p>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
