<%#
  views/public/login.ejs

  The login page for reporters and editors. public/js/public/login.js sends the form with
  fetch, so a wrong password is shown without reloading. A logged-in user never sees it.

  Rendered by: showLoginPage (controllers/authController.js), for GET /login.
  Owner: OS (logic) / SH (layout and partials).
%>
<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Log in - The Daily Web' }) %>

<body class="page-container">
    <%- include('../partials/header') %>

    <main class="main-content">
        <section class="card login-card" aria-labelledby="login-title">
            <h2 id="login-title">Log in</h2>
            <p class="login-intro">For reporters and editors. Readers don't need an account.</p>

            <%#
              method="post": if the script failed to load, GET would put the password in the
              address bar. The autocomplete values let a password manager fill in the login.
            %>
            <form id="login-form" method="post" action="/api/auth/login">
                <label for="username">Username</label>
                <input id="username" name="username" type="text" class="form-field" autocomplete="username" maxlength="30" required autofocus>

                <label for="password">Password</label>
                <input id="password" name="password" type="password" class="form-field" autocomplete="current-password" maxlength="200" required>

                <%# role="alert": screen readers announce the error at once. %>
                <p id="login-error" class="form-error" role="alert" hidden></p>

                <button id="login-button" class="btn btn-primary btn-block" type="submit">Log in</button>
            </form>
        </section>
    </main>

    <%- include('../partials/footer') %>

    <script src="/js/shared/apiClient.js"></script>
    <script src="/js/public/login.js"></script>
</body>
</html>
