<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Log in - The Web Daily</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <header>
    <a href="/">The Web Daily</a>
  </header>

  <main class="page-container">
    <section class="card" aria-labelledby="login-title">
      <h1 id="login-title">Log in</h1>
      <p>For reporters and editors. Readers don't need an account.</p>

      <%# method="post" matters even though the script sends the form itself: if the
          script ever fails to load, the browser would otherwise send the form with GET
          and put the password in the address bar and the browser history. %>
      <form id="login-form" method="post" action="/api/auth/login">
        <div class="form-field">
          <label for="username">Username</label>
          <%# autocomplete lets the browser's password manager fill and save the login. %>
          <input id="username" name="username" type="text" autocomplete="username" maxlength="30" required autofocus>
        </div>

        <div class="form-field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password" maxlength="200" required>
        </div>

        <%# role="alert" makes screen readers announce the error as soon as it appears. %>
        <p id="login-error" class="form-error" role="alert" hidden></p>

        <button id="login-button" class="btn btn-primary" type="submit">Log in</button>
      </form>
    </section>
  </main>

  <script src="/js/shared/apiClient.js"></script>
  <script>
    const loginForm = document.getElementById('login-form');
    const loginError = document.getElementById('login-error');
    const loginButton = document.getElementById('login-button');

    /**
     * Shows an error under the form. textContent (not innerHTML) puts the message in
     * as plain text, so a message can never add HTML or scripts to the page.
     *
     * @param {string} message - The text to show.
     * @returns {void}
     */
    function showLoginError(message) {
      loginError.textContent = message;
      loginError.hidden = false;
    }

    /**
     * Sends the username and password with fetch instead of the browser's normal
     * form submit, then goes to the user's area, or shows the server's error.
     *
     * @param {SubmitEvent} event - The form's submit event.
     * @returns {Promise<void>}
     */
    async function submitLoginForm(event) {
      // Stop the normal submit, which would load a new page.
      event.preventDefault();

      const username = loginForm.elements.username.value.trim();
      const password = loginForm.elements.password.value;

      // Checked here for a quick answer, and checked again on the server,
      // because anything in the browser can be bypassed.
      if (username === '' || password === '') {
        showLoginError('Please enter your username and password.');
        return;
      }

      // Disabled while waiting, so a double click doesn't send two logins.
      loginButton.disabled = true;
      loginError.hidden = true;

      const result = await apiClient.post('/api/auth/login', { username: username, password: password });

      if (!result.success) {
        showLoginError(result.error);
        loginButton.disabled = false;
        return;
      }

      // The server decides where each role goes; the browser only follows.
      window.location.assign(result.data.redirectTo);
    }

    loginForm.addEventListener('submit', submitLoginForm);
  </script>
</body>
</html>
