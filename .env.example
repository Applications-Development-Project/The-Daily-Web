# Template for your own .env file. Copy it ("copy .env.example .env" on Windows,
# "cp .env.example .env" on Mac/Linux) and fill in the values.
# This file is committed with EMPTY values only. Never put a real secret here:
# .env is in .gitignore, this file is not.
# Owner: OS. Shared file: change it only in a small, separate pull request.

# MongoDB connection string. The team uses a local database:
# mongodb://127.0.0.1:27017/the-web-daily
MONGODB_URI=

# Secret that signs the session cookie. Generate your own random value with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the server listens on. If left empty, server.js uses 3000.
PORT=

# OpenWeatherMap API key (free plan, no credit card). Your own, or SH's sent privately.
WEATHER_API_KEY=

# City shown in the weather widget, for example: Tel Aviv
WEATHER_CITY=

# Password given to every demo user by "npm run seed". Agree on it privately
# in the group chat. The seed refuses to run if this is empty.
SEED_DEMO_PASSWORD=
